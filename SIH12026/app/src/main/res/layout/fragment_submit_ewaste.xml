<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F6F9">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:id="@+id/textSubmitTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Submit E-Waste Disposal"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#222222"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/textSubmitSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Declare scrap specifications to get optimal market dispatch values"
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginTop="2dp"
            app:layout_constraintTop_toBottomOf="@id/textSubmitTitle"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@android:color/white"
            app:layout_constraintTop_toBottomOf="@id/textSubmitSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Category dropdown field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="E-Waste Material Category"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#444444"
                    android:layout_marginBottom="6dp" />

                <Spinner
                    android:id="@+id/spinnerEwasteCategory"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:spinnerMode="dropdown"
                    android:layout_marginBottom="16dp" />

                <!-- Approximate weight field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutScrapWeight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Estimated Weight (in Kg)"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="16dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editScrapWeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:singleLine="true"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Item Condition field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutScrapCondition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Condition Description (e.g., Burned, Intact, Stretches)"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="16dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editScrapCondition"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textLongMessage"
                        android:singleLine="true"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Source/Pickup Location field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutPickupLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Scrap Pickup Address / Warehouse location"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="20dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editPickupLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPostalAddress"
                        android:singleLine="true"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Interactive capture hardware button integration layout -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#F0F2F5"
                    android:padding="12dp"
                    android:layout_marginBottom="24dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCaptureScrap"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scan/Photo"
                        app:icon="@drawable/ic_camera" />

                    <TextView
                        android:id="@+id/textScrapPhotoStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="No e-waste image attached"
                        android:textSize="13sp"
                        android:textColor="#777777"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmitDisposal"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Publish Disposal Offer"
                    app:cornerRadius="8dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>